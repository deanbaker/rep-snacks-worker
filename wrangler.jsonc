{
  "$schema": "/opt/homebrew/Cellar/cloudflare-wrangler/4.127.1/libexec/lib/node_modules/wrangler/config-schema.json",
  "name": "daily-workouts",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "SUBS" }],
  // VAPID_PUBLIC_KEY and VAPID_PRIVATE_JWK are secrets (npm run vapid, then wrangler secret bulk vapid.secret.json).
  "vars": { "VAPID_SUBJECT": "https://daily-workouts.deano-baker.workers.dev" },
  // Every 5 minutes: hourly reminders fire at :15 local time, snoozes land within 5 min.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
