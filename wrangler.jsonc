{
  "$schema": "/opt/homebrew/Cellar/cloudflare-wrangler/4.127.1/libexec/lib/node_modules/wrangler/config-schema.json",
  "name": "daily-workouts",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [{ "binding": "SUBS" }],
  // Per-IP limit on the /api/* writes (the app makes a handful a day).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // VAPID_PUBLIC_KEY and VAPID_PRIVATE_JWK are secrets (npm run vapid, then wrangler secret bulk vapid.secret.json).
  "vars": {
    "VAPID_SUBJECT": "https://dean-baker.com/workouts/",
    "APP_URL": "https://dean-baker.com/workouts/",
    // Pages allowed to call the API. localhost:4000 is `bundle exec jekyll serve` in the blog repo.
    "ALLOWED_ORIGINS": "https://dean-baker.com,http://localhost:4000,http://127.0.0.1:4000"
  },
  // Every 5 minutes: hourly reminders fire at :15 local time, snoozes land within 5 min.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
